#!/bin/bash
set -e

echo ">>> Добавляю Магическую Палочку..."

# Создаем папки, если их нет
mkdir -p src/main/resources/assets/undoo/models/item
mkdir -p src/main/resources/assets/undoo/textures/item

# 1. Модель предмета (чтобы он отображался в инвентаре)
cat > src/main/resources/assets/undoo/models/item/magic_wand.json << 'EOF'
{
  "parent": "item/generated",
  "textures": {
    "layer0": "undoo:item/magic_wand_overlay"
  }
}
EOF

echo ">>> Модель создана: src/main/resources/assets/undoo/models/item/magic_wand.json"
echo ">>> Теперь тебе нужно закинуть картинку 'magic_wand_overlay.png' в папку textures/item/"
